FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 APP_ENV=production
WORKDIR /opt/leadengine
COPY requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock && useradd --uid 10001 --create-home leadengine
COPY --chown=10001:10001 app ./app
COPY --chown=10001:10001 config ./config
COPY --chown=10001:10001 scripts ./scripts
COPY --chown=10001:10001 lead_engine.py ./
RUN mkdir -p data output logs && chown -R 10001:10001 data output logs
USER 10001
EXPOSE 8080
CMD ["python","-m","uvicorn","app.api.server:app","--host","0.0.0.0","--port","8080","--no-server-header","--no-access-log"]
