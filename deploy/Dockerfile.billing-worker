FROM asia-south1-docker.pkg.dev/querryside/leadengine/worker@sha256:864dc597e1d30efe1b78878607bf068283b7f6f2c014128128ca5be5fbd3de70
ARG SOURCE_REV
LABEL org.opencontainers.image.revision=$SOURCE_REV
USER root
COPY requirements.lock /opt/leadengine/requirements.lock
RUN grep -E '^(dnspython|opentelemetry-api|pyasn1|pypdf|soupsieve)==' /opt/leadengine/requirements.lock >/tmp/security.lock && test "$(wc -l </tmp/security.lock)" -eq 5 && python -m pip install --no-deps --only-binary=:all: --no-cache-dir -r /tmp/security.lock && rm /tmp/security.lock
USER 10001:10001
COPY --chown=10001:10001 app /opt/leadengine/app
COPY --chown=10001:10001 scripts /opt/leadengine/scripts
RUN python -c "import jwt, websockets, openpyxl, reportlab; from app.database.migrations import MIGRATIONS; from app.database.intent_profile import migrations; assert len(MIGRATIONS) == 58 and migrations()[-1][0] == 1016"
