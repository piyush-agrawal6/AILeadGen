ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
COPY requirements.lock /opt/leadengine/requirements.lock
RUN pip install --no-cache-dir -r /opt/leadengine/requirements.lock && python -m pip check
# Keep the working browser/toolchain image, while matching the DuckDB extension
# cache to the exact version installed by the current lockfile.
RUN python -c "import duckdb; c=duckdb.connect(); c.execute(\"SET extension_directory='/opt/duckdb_extensions'; INSTALL httpfs\")"
COPY --chown=10001:10001 app /opt/leadengine/app
COPY --chown=10001:10001 config /opt/leadengine/config
COPY --chown=10001:10001 scripts /opt/leadengine/scripts
USER 10001
CMD ["python","-m","app.worker"]
