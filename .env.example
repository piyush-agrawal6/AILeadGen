# LeadEngine
APP_ENV=development

# Identify our crawler when visiting public business websites.
CRAWLER_USER_AGENT=LeadEngine/1.0 (+https://planebyte.com)

# Optional contact email used in User-Agent / geocoding identification.
CRAWLER_CONTACT_EMAIL=leadengine@planebyte.com

# Database
DATABASE_PATH=./data/lead_engine.db

# Overture Maps
# No API key required.
OVERTURE_S3_REGION=us-west-2

# Leave blank if code automatically discovers/configures current release.
OVERTURE_RELEASE=

# OpenStreetMap / Overpass
# No API key required.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Nominatim only for occasional market-name → bounding-box resolution.
# No API key required.
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Local tools
LIGHTHOUSE_COMMAND=lighthouse

# Crawl settings
CRAWL_MAX_PAGES=8
CRAWL_CONCURRENCY=4
HTTP_CONCURRENCY=15
LIGHTHOUSE_CONCURRENCY=1

# Dashboard server only. Generate independent random secrets of 32+ characters.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_USER_EMAILS=
AUTH_DISABLED_LOCAL=false
LEADENGINE_API_URL=http://127.0.0.1:8787
LEADENGINE_API_SIGNING_SECRET=

# Production requires PostgreSQL, GCP execution and private R2 storage.
DATABASE_URL=
SCAN_EXECUTOR=local
GCP_PROJECT_ID=
GCP_REGION=asia-south1
LEADENGINE_CLOUD_RUN_JOB=leadengine-worker
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
MAX_ACTIVE_SCANS=2
MAX_CITIES_PER_SCAN=10
MAX_TARGET_LEADS=1000
MAX_RAW_BUSINESSES=10000
MAX_LIGHTHOUSE_AUDITS=500
MAX_SCAN_RUNTIME_MINUTES=180
SEO_CRAWL_MAX_PAGES=30

# Client-facing PlaneByte PDF contact details (public information only)
PLANEBYTE_WEBSITE=https://planebyte.com
PLANEBYTE_PHONE=
REPORT_SHOW_PRICING=false

# Phase 3.6 public social enrichment (bounded, no login credentials)
SOCIAL_ENRICHMENT_ENABLED=true
SOCIAL_ACTIVITY_ENABLED=true
SOCIAL_ACTIVITY_RECENT_DAYS=30
SOCIAL_ACTIVITY_ACTIVE_DAYS=90
SOCIAL_ACTIVITY_CONCURRENCY=2
SOCIAL_PROFILE_MAX_REQUESTS_PER_BUSINESS=4
SOCIAL_PROFILE_TIMEOUT_SECONDS=8

# Client website-project offer; no invented monetary values
REPORT_OFFER_ENABLED=true
REPORT_OFFER_TITLE=Website Redesign Launch Package
REPORT_OFFER_SUBTITLE=Included at no additional charge with an eligible PlaneByte website project
REPORT_OFFER_INCLUDE_SEO_FOUNDATION=true
REPORT_OFFER_INCLUDE_SECURITY_HARDENING=true
REPORT_OFFER_INCLUDE_POST_LAUNCH_AUDIT=true
REPORT_SHOW_VALUE_STACK_PRICES=false

# Phase 4: reviewed Hostinger email (server only)
EMAIL_PROVIDER=hostinger
EMAIL_SEND_MODE=test
EMAIL_LIVE_APPROVED=false
EMAIL_TEST_RECIPIENT=
MAIL_FROM_NAME=PlaneByte
MAIL_FROM_ADDRESS=rajendra@planebyte.com
MAIL_USERNAME=rajendra@planebyte.com
MAIL_PASSWORD=
MAIL_SMTP_HOST=smtp.hostinger.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=true
MAIL_IMAP_HOST=imap.hostinger.com
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURE=true
EMAIL_SYNC_ENABLED=true
EMAIL_SYNC_INTERVAL_MINUTES=10
EMAIL_INITIAL_SYNC_DAYS=30
MAX_EMAILS_PER_HOUR=10
MAX_EMAILS_PER_DAY=30
DEFAULT_FOLLOWUP_DAYS=3
PLANEBYTE_COMPANY_NAME=PlaneByte
PLANEBYTE_CONTACT_EMAIL=rajendra@planebyte.com
MAIL_SIGNATURE_NAME=
MAIL_SIGNATURE_ROLE=
GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=

# Phase 4.1: owner-managed switch; deployment never enables live sending
EMAIL_SENDING_ENABLED=true
EMAIL_TRACKING_BASE_URL=https://leads.planebyte.com/t
EMAIL_SOFT_BOUNCE_THRESHOLD=3
