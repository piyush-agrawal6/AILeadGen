# LeadEngine
APP_ENV=development

# Identify our crawler when visiting public business websites.
CRAWLER_USER_AGENT=LeadEngine/1.0 (+https://planebyte.com)

# Optional contact email used in User-Agent / geocoding identification.
CRAWLER_CONTACT_EMAIL=leadengine@planebyte.com

# Database
DATABASE_PATH=./data/lead_engine.db

# Overture Maps
# No API key required.
OVERTURE_S3_REGION=us-west-2

# Leave blank if code automatically discovers/configures current release.
OVERTURE_RELEASE=

# OpenStreetMap / Overpass
# No API key required.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Nominatim only for occasional market-name → bounding-box resolution.
# No API key required.
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Local tools
LIGHTHOUSE_COMMAND=lighthouse

# Crawl settings
CRAWL_MAX_PAGES=8
CRAWL_CONCURRENCY=4
HTTP_CONCURRENCY=15
LIGHTHOUSE_CONCURRENCY=1
