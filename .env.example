# LeadEngine
APP_ENV=development

# Identify our crawler when visiting public business websites.
CRAWLER_USER_AGENT=LeadEngine/1.0 (+https://planebyte.com)

# Optional contact email used in User-Agent / geocoding identification.
CRAWLER_CONTACT_EMAIL=leadengine@planebyte.com

# Database
DATABASE_PATH=./data/lead_engine.db

# Overture Maps
# No API key required.
OVERTURE_S3_REGION=us-west-2

# Leave blank if code automatically discovers/configures current release.
OVERTURE_RELEASE=

# OpenStreetMap / Overpass
# No API key required.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Nominatim only for occasional market-name → bounding-box resolution.
# No API key required.
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Local tools
LIGHTHOUSE_COMMAND=lighthouse

# Crawl settings
CRAWL_MAX_PAGES=8
CRAWL_CONCURRENCY=4
HTTP_CONCURRENCY=15
LIGHTHOUSE_CONCURRENCY=1

# Dashboard server only. Generate independent random secrets of 32+ characters.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_DISABLED_LOCAL=false
LEADENGINE_API_URL=http://127.0.0.1:8787
LEADENGINE_API_SIGNING_SECRET=

# Production requires PostgreSQL, GCP execution and private R2 storage.
DATABASE_URL=
SCAN_EXECUTOR=local
GCP_PROJECT_ID=
GCP_REGION=asia-south1
LEADENGINE_CLOUD_RUN_JOB=leadengine-worker
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
MAX_ACTIVE_SCANS=2
MAX_CITIES_PER_SCAN=10
MAX_TARGET_LEADS=1000
MAX_RAW_BUSINESSES=10000
MAX_LIGHTHOUSE_AUDITS=500
MAX_SCAN_RUNTIME_MINUTES=180
SEO_CRAWL_MAX_PAGES=30

# Client-facing PlaneByte PDF contact details (public information only)
PLANEBYTE_WEBSITE=https://planebyte.com
PLANEBYTE_PHONE=
REPORT_SHOW_PRICING=false

# Phase 3.6 public social enrichment (bounded, no login credentials)
SOCIAL_ENRICHMENT_ENABLED=true
SOCIAL_ACTIVITY_ENABLED=true
SOCIAL_ACTIVITY_RECENT_DAYS=30
SOCIAL_ACTIVITY_ACTIVE_DAYS=90
SOCIAL_ACTIVITY_CONCURRENCY=2
SOCIAL_PROFILE_MAX_REQUESTS_PER_BUSINESS=4
SOCIAL_PROFILE_TIMEOUT_SECONDS=8

# Client website-project offer; no invented monetary values
REPORT_OFFER_ENABLED=true
REPORT_OFFER_TITLE=Website Redesign Launch Package
REPORT_OFFER_SUBTITLE=Included at no additional charge with an eligible PlaneByte website project
REPORT_OFFER_INCLUDE_SEO_FOUNDATION=true
REPORT_OFFER_INCLUDE_SECURITY_HARDENING=true
REPORT_OFFER_INCLUDE_POST_LAUNCH_AUDIT=true
REPORT_SHOW_VALUE_STACK_PRICES=false

# Server-only Gmail; production credentials belong in Secret Manager.
EMAIL_PROVIDER=gmail
EMAIL_SEND_MODE=test
EMAIL_LIVE_APPROVED=false
EMAIL_TEST_RECIPIENT=
MAIL_FROM_NAME=PlaneByte
MAIL_FROM_ADDRESS=planebyte@gmail.com
GMAIL_USERNAME=planebyte@gmail.com
GMAIL_APP_PASSWORD=
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
GMAIL_SMTP_SECURE=true
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_IMAP_SECURE=true
EMAIL_SYNC_ENABLED=true
EMAIL_SYNC_INTERVAL_MINUTES=5
EMAIL_INITIAL_SYNC_DAYS=30
EMAIL_TRACKING_ENABLED=true
EMAIL_TRACKING_BASE_URL=https://leads.planebyte.com/t
MAX_EMAILS_PER_HOUR=10
MAX_EMAILS_PER_DAY=100
DAILY_EMAIL_TARGET=100
DAILY_QUALIFIED_LEAD_TARGET=100
AUTO_SCAN_ENABLED=false
AUTO_EMAIL_ENABLED=false
EMAIL_SENDING_ENABLED=false
DEFAULT_FOLLOWUP_DAYS=3
AUTOMATION_TIMEZONE=Asia/Kolkata
EMAIL_SOFT_BOUNCE_THRESHOLD=3

OUTREACH_SENDER_NAME=

OUTREACH_SENDER_ROLE=
# Server-only shared read cache (optional; uses live DB when unavailable).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional acquisition sources: server-only; independent of existing scanning/outreach.
ENABLE_AI_ACQUISITION=false
ENABLE_FIRECRAWL_ACQUISITION=false
ENABLE_LEAD_IMPORT=false
ENABLE_GOOGLE_SHEETS_IMPORT=false
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev
GOOGLE_SHEETS_REDIRECT_URI=https://leads.planebyte.com/acquisition/sheets/callback
ACQUISITION_CLOUD_RUN_JOB=leadengine-acquisition

# Server-only copy batching; one configured Gemini key, no rotation.
GEMINI_COPY_BATCH_SIZE=40
AI_PRIMARY_PROVIDER=vertex
VERTEX_AI_ENABLED=true
VERTEX_AI_PROJECT_ID=querryside
VERTEX_AI_LOCATION=global
VERTEX_AI_MODEL=gemini-3.6-flash
GEMINI_API_ENABLED=true
AI_FALLBACK_ENABLED=true

LEAD_QUALIFICATION_MODE=CONTACTABLE_ONLY

ENABLE_PRE_OUTREACH_ANALYSIS=false

# Customer connections: server-only, independent of internal Gmail/Sheets accounts.
# Keep disabled until configuration and controlled owner acceptance are approved.
HEYSOW_CUSTOMER_INTEGRATIONS_ENABLED=false
HEYSOW_WEBHOOKS_ENABLED=false
HEYSOW_INTEGRATION_ENCRYPTION_KEY=

# Optional reviewed company profile AI through the existing provider gateway.
HEYSOW_COMPANY_AI_ENABLED=false
HEYSOW_COMPANY_AI_DAILY_LIMIT=10
HEYSOW_COMPANY_AI_GLOBAL_DAILY_LIMIT=100
ALLOWED_USER_EMAILS=planebyte@gmail.com,syntaxwars@gmail.com,agrawaljoy1@gmail.com


INTENT_RADAR_AI_ENABLED=true
INTENT_RADAR_AI_DAILY_CALLS=50
INTENT_RADAR_AI_DAILY_TOKENS=100000

INTENT_RADAR_SCHEDULES_ENABLED=true
INTENT_RADAR_MIN_SCHEDULE_HOURS=6

# Optional: get an application key from Stack Apps
INTENT_RADAR_STACKEXCHANGE_KEY=
INTENT_RADAR_STACKEXCHANGE_ENABLED=true

HEYSOW_DEVELOPER_API_ENABLED=true
HEYSOW_MCP_ENABLED=true

MCP_ALLOWED_HOSTS=app.planebyte.com
MCP_ALLOWED_ORIGINS=https://app.planebyte.com
# Intent Radar billing: internal Test Mode only; never commercial checkout.
BILLING_ENABLED=false
BILLING_PROVIDER=razorpay
BILLING_TEST_MODE=true
BILLING_PUBLIC_CHECKOUT_ENABLED=false
BILLING_TEST_WORKSPACES=
BILLING_CATALOG_JSON=
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TEST_PLAN_ID_STARTER=
RAZORPAY_TEST_PLAN_ID_GROWTH=
RAZORPAY_TEST_PLAN_ID_SCALE=
LEAD_ENGINE_PUBLIC_ENABLED=false
LEAD_ENGINE_AVAILABLE=false
