dashboard/.next*/
.next-preview-test/
.next-auth-test/
*.tsbuildinfo
playwright-report/
test-results/
deploy/api-url.txt
deploy/images.json
dashboard/.vercel/

# Playwright & browser caches
.playwright/
ms-playwright/

# OS specific
Thumbs.db
Desktop.ini
.DS_Store
node_modules

dashboard/.next-workflow-test/
dashboard/.next-intent-radar-test/
dashboard/.next-intent-radar-build/
dashboard/.next-gmail-test/
dashboard/.next-gmail-build/
dashboard/.next-intent-radar23-build/
