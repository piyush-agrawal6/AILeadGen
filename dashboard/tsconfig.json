{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-intent-radar-test/types/**/*.ts",
    ".next-intent-radar-test/dev/types/**/*.ts",
    ".next-intent-radar-build/types/**/*.ts",
    ".next-intent-radar-build/dev/types/**/*.ts",
    ".next-gmail-test/types/**/*.ts",
    ".next-gmail-test/dev/types/**/*.ts",
    ".next-intent-radar-ui-test/types/**/*.ts",
    ".next-intent-radar-ui-test/dev/types/**/*.ts",
    ".next-gmail-build/types/**/*.ts",
    ".next-gmail-build/dev/types/**/*.ts",
    ".next-intent-radar-ui-build/types/**/*.ts",
    ".next-intent-radar-ui-build/dev/types/**/*.ts",
    ".next-intent-radar23-build/types/**/*.ts",
    ".next-intent-radar23-build/dev/types/**/*.ts",
    ".next-intent-radar23-product-build/types/**/*.ts",
    ".next-intent-radar23-product-build/dev/types/**/*.ts",
    ".next-growth-build/types/**/*.ts",
    ".next-growth-build/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next-*"
  ]
}
