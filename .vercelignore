# Ignore root-level backend and local test artifacts ONLY (leading slash anchors to repo root)
/.env*
/.venv*
/.venv
/tests
/app
/data
/scripts
/docs
/tmp
/output
/local.db
/*.db
/*.sqlite*
/*.zip
/*.tar*
/*.tar.gz
/*.tgz
/*.png
/*.jpg
/*.svg

# Ignore large separate website clones at root
/planebyte-website
/planebyte-website/
/planebyte-website-new
/planebyte-website-new/
/planebyte-website-new.backup-checkpoint
/planebyte-website-new.backup-checkpoint/
/planebyte-website*

# Ignore dashboard local caches and node_modules
dashboard/node_modules
dashboard/node_modules/**
dashboard/.next
dashboard/.next/**
dashboard/.next*
dashboard/.vitest
dashboard/test-results
dashboard/coverage

# Explicitly ensure dashboard/app and dashboard/scripts are included
!dashboard/app/**
!dashboard/public/**
!dashboard/scripts/**
!dashboard/release-policy.json
